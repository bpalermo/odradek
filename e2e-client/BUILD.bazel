load("@rules_java//java:defs.bzl", "java_binary", "java_library")
load("//bazel:registry.bzl", "IMAGE_REGISTRY", "image_repository")
load("//bazel/image:defs.bzl", "java_image")
load("//bazel/java:defs.bzl", "JAVACOPTS")
load("//bazel/java:junit.bzl", "java_junit_test")

package(default_visibility = ["//visibility:private"])

# The test application of the in-cluster end-to-end run: a producer, a consumer
# or both, on the Java client or on the Kafka clients directly, which keeps its
# own account of every record and serves it on GET /results. See README.md.
java_library(
    name = "lib",
    srcs = glob(["src/main/java/**/*.java"]),
    javacopts = JAVACOPTS,
    # The end-to-end suite runs every mode against a real server and broker.
    visibility = ["//e2e:__pkg__"],
    # The OTLP exporter's transport on grpc-java, found through ServiceLoader:
    # the server's, so there is one gRPC and one Netty.
    runtime_deps = ["@maven//:io_opentelemetry_opentelemetry_exporter_sender_grpc_managed_channel"],
    deps = [
        "//api/odradek/config/v1:config_java_proto",
        "//client/java:client",
        # The kafka transport's TLS is the server's: SPIFFE Workload API,
        # rotation, and brokers verified by SPIFFE ID.
        "//server:tls",
        "@grpc-java//api",
        "@grpc-java//netty",
        "@maven//:io_netty_netty_transport",
        "@maven//:io_netty_netty_transport_classes_epoll",
        "@maven//:io_opentelemetry_opentelemetry_api",
        "@maven//:io_opentelemetry_opentelemetry_exporter_otlp",
        "@maven//:io_opentelemetry_opentelemetry_sdk_common",
        "@maven//:io_opentelemetry_opentelemetry_sdk_metrics",
        "@maven//:org_apache_kafka_kafka_clients",
        "@maven//:org_hdrhistogram_HdrHistogram",
        "@maven//:org_slf4j_slf4j_api",
        "@protobuf//java/core",
    ],
)

# logback.xml, in a jar of its own so that it reaches the binary and not the
# end-to-end suite, whose class path has the server's.
java_library(
    name = "logging",
    resource_strip_prefix = "e2e-client/src/main/resources",
    resources = ["src/main/resources/logback.xml"],
)

# Netty's epoll transport loads a native library, which Java 25 warns about
# unless native access is granted.
JVM_FLAGS = ["--enable-native-access=ALL-UNNAMED"]

java_binary(
    name = "e2e-client",
    jvm_flags = JVM_FLAGS,
    main_class = "io.github.bpalermo.odradek.e2eclient.Main",
    runtime_deps = [
        ":lib",
        ":logging",
        # The epoll transport's native code, needed for the Unix socket, is a
        # jar per architecture: the server's select() picks the target CPU's.
        "//server:netty_epoll_native",
        "@maven//:ch_qos_logback_logback_classic",
    ],
)

# quay.io/odradek/e2e-client, linux/amd64 and linux/arm64, on the same base and
# by the same macro as the server's JVM image. Published by publish.yml.
java_image(
    name = "image",
    base = "@distroless_java25",
    deploy_jar = ":e2e-client_deploy.jar",
    jar_path = "/app/e2e-client.jar",
    jvm_flags = JVM_FLAGS,
    load_tag = "localhost/odradek-e2e-client:e2e",
    registry = IMAGE_REGISTRY,
    repository = image_repository("e2e-client"),
)

java_junit_test(
    name = "test",
    size = "small",
    srcs = glob(["src/test/java/**/*.java"]),
    javacopts = JAVACOPTS,
    test_classes = [
        "io.github.bpalermo.odradek.e2eclient.ConsumerLedgerTest",
        "io.github.bpalermo.odradek.e2eclient.FaultsTest",
        "io.github.bpalermo.odradek.e2eclient.JsonTest",
        "io.github.bpalermo.odradek.e2eclient.KafkaClientsTest",
        "io.github.bpalermo.odradek.e2eclient.LatencyTest",
        "io.github.bpalermo.odradek.e2eclient.OtlpMetricsTest",
        "io.github.bpalermo.odradek.e2eclient.ProducerLedgerTest",
        "io.github.bpalermo.odradek.e2eclient.RateScheduleTest",
        "io.github.bpalermo.odradek.e2eclient.RecordValueTest",
        "io.github.bpalermo.odradek.e2eclient.ResultsServerTest",
        "io.github.bpalermo.odradek.e2eclient.SettingsTest",
    ],
    # OtlpMetricsTest starts the exporter, on Netty's epoll transport.
    runtime_deps = ["//server:netty_epoll_native"],
    deps = [
        ":lib",
        "//api/odradek/config/v1:config_java_proto",
        "@maven//:org_apache_kafka_kafka_clients",
        "@maven//:org_assertj_assertj_core",
        "@maven//:org_junit_jupiter_junit_jupiter_api",
    ],
)
