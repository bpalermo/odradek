<?xml version="1.0" encoding="UTF-8"?>
<!-- Logs go to stderr at INFO: stdout holds only this program's JSON lines.
     Without this file logback defaults to DEBUG, and Netty and gRPC log every
     internal setting at that level. -->
<configuration>
  <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
    <target>System.err</target>
    <encoder>
      <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX,UTC} %-5level [%thread] %logger{36} -- %msg%n</pattern>
    </encoder>
  </appender>
  <root level="INFO">
    <appender-ref ref="STDERR"/>
  </root>
</configuration>
