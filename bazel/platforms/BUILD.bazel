# The image platforms. Defined here rather than borrowed from a language
# ruleset: the Java image is cross-built on any host by switching only the
# target platform (the bytecode is portable; the platform picks the netty epoll
# native jar).
package(default_visibility = ["//visibility:public"])

platform(
    name = "linux_amd64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
)

platform(
    name = "linux_arm64",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:linux",
    ],
)
