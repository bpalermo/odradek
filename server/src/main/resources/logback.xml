<?xml version="1.0" encoding="UTF-8"?>
<!-- Console logging at INFO. Without this file logback defaults to DEBUG, and
     Netty and the Kafka clients log every internal setting at that level. -->
<configuration>
  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX,UTC} %-5level [%thread] %logger{36} -- %msg%n</pattern>
    </encoder>
  </appender>
  <root level="INFO">
    <appender-ref ref="STDOUT"/>
  </root>
</configuration>
