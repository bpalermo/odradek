load("@rules_graalvm//graalvm:defs.bzl", "native_image")
load("@rules_java//java:defs.bzl", "java_binary", "java_library")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//bazel:registry.bzl", "IMAGE_REGISTRY", "image_repository")
load("//bazel/image:defs.bzl", "executable_image", "java_image")
load("//bazel/java:defs.bzl", "JAVACOPTS")
load("//bazel/java:junit.bzl", "java_junit_test")

package(default_visibility = ["//visibility:private"])

# Netty's epoll transport and the Kafka clients' compression codecs load native
# libraries. Java 25 warns about that unless native access is granted, and a
# later release will refuse.
JVM_FLAGS = ["--enable-native-access=ALL-UNNAMED"]

_TEST_PKI = [
    "src/test/java/io/github/bpalermo/odradek/server/telemetry/FakeCollector.java",
    "src/test/java/io/github/bpalermo/odradek/server/tls/FakeWorkloadApi.java",
    "src/test/java/io/github/bpalermo/odradek/server/tls/TestPki.java",
]

java_library(
    name = "server_lib",
    srcs = glob(["src/main/java/**/*.java"]),
    javacopts = JAVACOPTS,
    resource_strip_prefix = "server/src/main/resources",
    resources = glob(["src/main/resources/**"]),
    visibility = ["//e2e:__pkg__"],
    # The OTLP exporter's transport on grpc-java, found through ServiceLoader.
    runtime_deps = ["@maven//:io_opentelemetry_opentelemetry_exporter_sender_grpc_managed_channel"],
    deps = [
        "//api/odradek/config/v1:config_java_proto",
        "//api/odradek/kafka/v1:odradek_java_grpc",
        "//api/odradek/kafka/v1:odradek_java_proto",
        "//extension/java:extension",
        "@grpc-java//api",
        "@grpc-java//netty",
        "@grpc-java//stub",
        "@maven//:build_buf_protovalidate",
        "@maven//:io_netty_netty_transport",
        "@maven//:io_netty_netty_transport_classes_epoll",
        "@maven//:io_netty_netty_transport_native_unix_common",
        "@maven//:io_opentelemetry_opentelemetry_api",
        "@maven//:io_opentelemetry_opentelemetry_exporter_otlp",
        "@maven//:io_opentelemetry_opentelemetry_sdk_common",
        "@maven//:io_opentelemetry_opentelemetry_sdk_metrics",
        "@maven//:org_apache_kafka_kafka_clients",
        "@maven//:org_slf4j_slf4j_api",
        "@maven//:org_snakeyaml_snakeyaml_engine",
        "@protobuf//java/core",
        "@protobuf//java/util",
    ],
)

# Netty's epoll transport (needed for AF_UNIX) ships its native code in a
# per-architecture classifier jar; pick the one for the target CPU.
java_library(
    name = "netty_epoll_native",
    visibility = ["//e2e:__pkg__"],
    exports = ["@maven//:io_netty_netty_transport_native_unix_common"] + select({
        "@platforms//cpu:aarch64": ["@maven//:io_netty_netty_transport_native_epoll_linux_aarch_64"],
        "//conditions:default": ["@maven//:io_netty_netty_transport_native_epoll_linux_x86_64"],
    }),
)

# What the server runs with, beyond the code it is compiled against.
SERVER_RUNTIME_DEPS = [
    ":netty_epoll_native",
    ":server_lib",
    "@maven//:ch_qos_logback_logback_classic",
]

java_binary(
    name = "server",
    jvm_flags = JVM_FLAGS,
    main_class = "io.github.bpalermo.odradek.server.Main",
    visibility = ["//visibility:public"],
    runtime_deps = SERVER_RUNTIME_DEPS,
)

# The same class path as a library: a java_binary's JavaInfo carries no runtime
# jars, and the native image is compiled from the jars, not the launcher.
java_library(
    name = "server_runtime",
    visibility = ["//visibility:public"],
    runtime_deps = SERVER_RUNTIME_DEPS,
)

# Reflection, resource and JNI metadata of the native image. Exported so that an
# image with extra codec classes can add its own metadata next to it.
filegroup(
    name = "native_metadata",
    srcs = glob(["native-image/*.json"]),
    visibility = ["//visibility:public"],
)

# The same jars as :server, compiled ahead of time (ADR 5). Linux only, and for
# the architecture of the machine building it: GraalVM does not cross-compile.
native_image(
    name = "server_native",
    data = [":native_metadata"],
    executable_name = "%target%",
    extra_args = [
        # The reachability metadata of :native_metadata.
        "-H:ConfigurationFileDirectories=server/native-image",
        # Not tuned to the machine that happens to build it: the image runs on
        # whatever node it is scheduled to.
        "-march=compatibility",
        # Heap of the image builder: a ceiling, not a reservation.
        "-J-Xmx8g",
        # Netty's clock is System.nanoTime() minus the value it had when this
        # class was initialized. Initialized while the image is built, that
        # value is the build machine's, and on a machine whose monotonic clock
        # reads less (it booted more recently) Netty's time is negative: every
        # timer on a Netty event loop then fires at once, among them the
        # deadline of each gRPC call. Netty's own metadata still names the class
        # that held this in 4.1 (ScheduledFutureTask), not this one.
        # //server:native_config_test runs the image with such a clock.
        "--initialize-at-run-time=io.netty.util.concurrent.SystemTicker",
        # zlib linked in, libc not: runs on a base that has glibc and nothing
        # else, and netty's epoll library can still be loaded.
        "--static-nolibc",
    ],
    # Logback is configured while the image is built (netty, initialized at
    # build time, creates its loggers then): logback.xml is read here, not at
    # start.
    initialize_at_build_time = [
        "ch.qos.logback",
        "org.slf4j",
    ],
    main_class = "io.github.bpalermo.odradek.server.Main",
    # Always fully optimized: without this the rule follows --compilation_mode
    # and the default (fastbuild) asks native-image for a quick build (-Ob).
    optimization_mode = "2",
    # Not part of //...: building it needs gcc and zlib, and a minute of 4 GB.
    # CI's `native` job builds and tests it by name.
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:linux"],
    visibility = ["//visibility:public"],
    deps = [":server_runtime"],
)

# A serializer in a jar of its own, as an extension directory would hold it.
java_library(
    name = "native_fixture",
    srcs = glob(["src/native_fixture/java/**/*.java"]),
    javacopts = JAVACOPTS,
    deps = ["@maven//:org_apache_kafka_kafka_clients"],
)

# What the native image does with configurations, without a broker: starts and
# stops, accepts Kafka's own codecs, rejects what it cannot load.
sh_test(
    name = "native_config_test",
    size = "small",
    srcs = ["native_config_test.sh"],
    args = ["$(rootpath :server_native)"],
    data = [
        "testdata/native/monotonic_back.c",
        ":native_fixture",
        ":server_native",
    ],
    env = {
        "CLOCK_SHIM": "$(rootpath testdata/native/monotonic_back.c)",
        "EXTENSION_JAR": "$(rootpath :native_fixture)",
    },
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:linux"],
)

java_image(
    name = "image",
    base = "@distroless_java25",
    deploy_jar = ":server_deploy.jar",
    jar_path = "/app/server.jar",
    jvm_flags = JVM_FLAGS,
    load_tag = "localhost/odradek:e2e",
    registry = IMAGE_REGISTRY,
    repository = image_repository("odradek"),
)

# The native variant of the image (ADR 5): one architecture per machine.
executable_image(
    name = "image_native",
    base = "@distroless_base_nossl",
    binary = ":server_native",
    load_tag = "localhost/odradek:e2e-native",
    registry = IMAGE_REGISTRY,
    repository = image_repository("odradek"),
    tag_flag = ":image_tag",
)

# A throwaway certificate authority, a stand-in SPIRE agent and a stand-in
# OpenTelemetry collector, for the tests here and for the end-to-end suite (//e2e:pki makes the mTLS broker's
# certificates).
java_library(
    name = "test_pki",
    testonly = True,
    srcs = _TEST_PKI,
    javacopts = JAVACOPTS,
    visibility = ["//e2e:__pkg__"],
    deps = [
        ":server_lib",
        "@grpc-java//api",
        "@grpc-java//netty",
        "@grpc-java//stub",
        "@maven//:io_netty_netty_transport",
        "@maven//:io_netty_netty_transport_classes_epoll",
        "@maven//:io_netty_netty_transport_native_unix_common",
        "@protobuf//java/core",
    ],
)

java_junit_test(
    name = "main_test",
    size = "small",
    srcs = glob(
        ["src/test/java/**/*.java"],
        exclude = _TEST_PKI,
    ),
    data = glob(["testdata/**"]) + glob(["native-image/*.json"]),
    javacopts = JAVACOPTS,
    test_classes = [
        "io.github.bpalermo.odradek.server.MainTest",
        "io.github.bpalermo.odradek.server.NativeMetadataTest",
        "io.github.bpalermo.odradek.server.OdradekServerTest",
        "io.github.bpalermo.odradek.server.admin.AdminServerTest",
        "io.github.bpalermo.odradek.server.admin.RequiredClustersTest",
        "io.github.bpalermo.odradek.server.codec.CodecRegistryTest",
        "io.github.bpalermo.odradek.server.codec.ContractRegistryTest",
        "io.github.bpalermo.odradek.server.codec.ExtensionsTest",
        "io.github.bpalermo.odradek.server.config.ConfigLoaderTest",
        "io.github.bpalermo.odradek.server.consume.ConsumeServiceTest",
        "io.github.bpalermo.odradek.server.consume.PartitionStateTest",
        "io.github.bpalermo.odradek.server.produce.ProduceServiceTest",
        "io.github.bpalermo.odradek.server.config.ServerConfigValidationTest",
        "io.github.bpalermo.odradek.server.telemetry.KafkaClientMetricsTest",
        "io.github.bpalermo.odradek.server.telemetry.TelemetryTest",
        "io.github.bpalermo.odradek.server.tls.TlsTest",
        "io.github.bpalermo.odradek.server.tls.WorkloadApiTest",
    ],
    runtime_deps = [
        ":netty_epoll_native",
        "@maven//:ch_qos_logback_logback_classic",
    ],
    deps = [
        ":server_lib",
        ":test_pki",
        "//api/odradek/config/v1:config_java_proto",
        "//api/odradek/kafka/v1:odradek_java_grpc",
        "//api/odradek/kafka/v1:odradek_java_proto",
        "//extension/java:extension",
        "@grpc-java//api",
        "@grpc-java//inprocess",
        "@grpc-java//netty",
        "@grpc-java//stub",
        "@maven//:build_buf_protovalidate",
        "@maven//:io_netty_netty_transport",
        "@maven//:io_netty_netty_transport_classes_epoll",
        "@maven//:io_netty_netty_transport_native_unix_common",
        "@maven//:io_opentelemetry_opentelemetry_api",
        "@maven//:io_opentelemetry_opentelemetry_sdk_metrics",
        "@maven//:io_opentelemetry_opentelemetry_sdk_testing",
        "@maven//:org_apache_kafka_kafka_clients",
        "@maven//:org_assertj_assertj_core",
        "@maven//:org_junit_jupiter_junit_jupiter_api",
        "@protobuf//java/core",
        "@protobuf//java/util",
    ],
)
