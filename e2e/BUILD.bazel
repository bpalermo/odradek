load("@rules_clj//clojure:defs.bzl", "clj_library", "clj_test")
load("@rules_java//java:defs.bzl", "java_binary")
load("//bazel/java:defs.bzl", "JAVACOPTS")
load("//bazel/java:junit.bzl", "java_junit_test")

package(default_visibility = ["//visibility:private"])

# End-to-end tests need real Kafka brokers, so they are not part of `bazel test
# //...` (.bazelrc: `test --test_tag_filters=-e2e`). Run them with
#
#   ODRADEK_E2E_KAFKA_A=localhost:9092 ODRADEK_E2E_KAFKA_B=localhost:9093 \
#     bazel test //e2e/... --config=e2e
#
# Tags: `e2e` selects (and excludes) them; `external` and `requires-network`
# say they talk to something outside the build, so Bazel never caches the result
# or sandboxes the network away.
#
# `e2e_native_binary_test` is tagged manual as well, because it builds the native
# image: name it, `bazel test //e2e:e2e_native_binary_test --config=e2e`.
_DEPS = [
    "//api/odradek/config/v1:config_java_proto",
    "//api/odradek/kafka/v1:odradek_java_grpc",
    "//api/odradek/kafka/v1:odradek_java_proto",
    "//client/java:client",
    "//server:server_lib",
    "@grpc-java//api",
    "@grpc-java//netty",
    "@grpc-java//stub",
    "@maven//:io_netty_netty_transport",
    "@maven//:io_netty_netty_transport_classes_epoll",
    "@maven//:io_netty_netty_transport_native_unix_common",
    "@maven//:org_apache_kafka_kafka_clients",
    "@maven//:org_assertj_assertj_core",
    "@maven//:org_junit_jupiter_junit_jupiter_api",
    "@protobuf//java/core",
]

_TAGS = [
    "e2e",
    "external",
    "requires-network",
]

# The server assembled inside the test JVM. Fastest to run and to debug.
java_junit_test(
    name = "e2e_test",
    size = "large",
    srcs = glob(["src/test/java/**/*.java"]),
    javacopts = JAVACOPTS,
    tags = _TAGS,
    test_classes = [
        "io.github.bpalermo.odradek.e2e.BrokerSmokeTest",
        "io.github.bpalermo.odradek.e2e.ClientE2eTest",
        "io.github.bpalermo.odradek.e2e.CompressionE2eTest",
        "io.github.bpalermo.odradek.e2e.ConsumeE2eTest",
        "io.github.bpalermo.odradek.e2e.ProduceE2eTest",
    ],
    runtime_deps = [
        "//server:netty_epoll_native",
        "@maven//:ch_qos_logback_logback_classic",
    ],
    deps = _DEPS,
)

# The same suite against the packaged server, started as a separate process
# with a configuration file and stopped with SIGTERM: what a pod runs.
java_junit_test(
    name = "e2e_jvm_binary_test",
    size = "large",
    srcs = glob(["src/test/java/**/*.java"]),
    data = ["//server"],
    env = {"ODRADEK_E2E_SERVER": "$(rootpath //server)"},
    javacopts = JAVACOPTS,
    tags = _TAGS,
    test_classes = [
        "io.github.bpalermo.odradek.e2e.ClientE2eTest",
        "io.github.bpalermo.odradek.e2e.CompressionE2eTest",
        "io.github.bpalermo.odradek.e2e.ConsumeE2eTest",
        "io.github.bpalermo.odradek.e2e.ProduceE2eTest",
    ],
    runtime_deps = [
        "//server:netty_epoll_native",
        "@maven//:ch_qos_logback_logback_classic",
    ],
    deps = _DEPS,
)

# The same again against the native image of the server (ADR 5), compiled
# ahead of time by GraalVM. A test that passes on the JVM and fails here is a
# failure of the native image.
java_junit_test(
    name = "e2e_native_binary_test",
    size = "large",
    srcs = glob(["src/test/java/**/*.java"]),
    data = ["//server:server_native"],
    env = {"ODRADEK_E2E_SERVER": "$(rootpath //server:server_native)"},
    javacopts = JAVACOPTS,
    # server_native is built by CI's `native` job, not by //...
    tags = _TAGS + ["manual"],
    target_compatible_with = ["@platforms//os:linux"],
    test_classes = [
        "io.github.bpalermo.odradek.e2e.ClientE2eTest",
        "io.github.bpalermo.odradek.e2e.CompressionE2eTest",
        "io.github.bpalermo.odradek.e2e.ConsumeE2eTest",
        "io.github.bpalermo.odradek.e2e.ProduceE2eTest",
    ],
    runtime_deps = [
        "//server:netty_epoll_native",
        "@maven//:ch_qos_logback_logback_classic",
    ],
    deps = _DEPS,
)

# The Clojure client (//client/clojure, ADR 2) through the same list of cases as
# ClientE2eTest, against the packaged server started as a process.
clj_library(
    name = "clojure_client_e2e_test_lib",
    testonly = True,
    srcs = ["src/test/clojure/odradek/e2e/client_e2e_test.clj"],
    namespaces = ["odradek.e2e.client-e2e-test"],
    strip_prefix = "e2e/src/test/clojure",
    deps = [
        "//client/clojure:client",
        "@maven//:org_apache_kafka_kafka_clients",
    ],
)

clj_test(
    name = "clojure_client_e2e_test",
    size = "large",
    data = ["//server"],
    env = {"ODRADEK_E2E_SERVER": "$(rootpath //server)"},
    ns = "odradek.e2e.client-e2e-test",
    tags = _TAGS,
    deps = [":clojure_client_e2e_test_lib"],
)

# Creates and deletes topics for the suites of the other clients (//e2e/python),
# which run it as a process instead of carrying a Kafka client of their own.
java_binary(
    name = "topics",
    srcs = ["src/main/java/io/github/bpalermo/odradek/e2e/Topics.java"],
    javacopts = JAVACOPTS,
    main_class = "io.github.bpalermo.odradek.e2e.Topics",
    visibility = ["//e2e:__subpackages__"],
    deps = ["@maven//:org_apache_kafka_kafka_clients"],
)
