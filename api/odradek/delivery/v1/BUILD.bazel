load("//bazel/proto:defs.bzl", "odradek_proto_library")

package(default_visibility = ["//visibility:private"])

# The protocol between a sidecar and a dispatcher (ADR 6). Both ends are the
# server; no client library carries it.
odradek_proto_library(
    name = "delivery",
    grpc = True,
    visibility = [
        "//e2e:__subpackages__",
        "//server:__subpackages__",
    ],
    deps = ["//api/odradek/kafka/v1:odradek_proto"],
)
