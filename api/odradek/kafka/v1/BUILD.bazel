load("//bazel/proto:defs.bzl", "odradek_proto_library")

package(default_visibility = ["//visibility:private"])

# The generated libraries are for the server, the clients and the e2e suite only.
odradek_proto_library(
    name = "odradek",
    # Every Clojure namespace already maps Error to java.lang.Error.
    clj_shadowed = ["Error"],
    grpc = True,
    visibility = [
        "//client:__subpackages__",
        "//e2e:__subpackages__",
        "//server:__subpackages__",
    ],
)
