load("//bazel/proto:defs.bzl", "odradek_proto_library")

package(default_visibility = ["//visibility:private"])

odradek_proto_library(
    name = "config",
    # It imports buf/validate/validate.proto, which has no Clojure namespace.
    clojure = False,
    visibility = [
        # The e2e-client's kafka transport loads its TLS as a cluster's tls
        # section, with the server's TlsSources.
        "//e2e-client:__pkg__",
        "//e2e:__subpackages__",
        "//server:__subpackages__",
    ],
    deps = [
        "@protobuf//:duration_proto",
        "@protobuf//:timestamp_proto",
        "@protovalidate//proto/protovalidate/buf/validate:validate_proto",
    ],
)
