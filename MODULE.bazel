"""odradek: a server that owns the Kafka clients for an application, spoken to over gRPC on a Unix domain socket."""

module(
    name = "odradek",
    version = "0.0.0",
)

bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "rules_java", version = "9.9.0")
bazel_dep(name = "rules_jvm_external", version = "7.1")
bazel_dep(name = "protobuf", version = "36.2")
bazel_dep(name = "grpc-java", version = "1.84.0")

# Container image (//server:image_*) and the cosign CLI that verifies it.
bazel_dep(name = "rules_img", version = "0.3.21")
bazel_dep(name = "rules_img_signer_cosign", version = "0.0.1")
bazel_dep(name = "rules_shell", version = "0.8.0")

# Transitive dependency of rules_img pinned for Bazel 9: older versions (via
# rules_pkg) use the removed incompatible_use_toolchain_transition keyword.
bazel_dep(name = "rules_foreign_cc", version = "0.16.0")

# buf.validate protos (buf/validate/validate.proto) for protovalidate rules in config protos.
bazel_dep(name = "protovalidate", version = "1.2.2")

# grpc-java builds its protoc plugin AND protoc itself from C++ source (hundreds
# of C++ compiles). The patch repoints its codegen at the prebuilt
# protoc-gen-grpc-java from Maven Central (http_file repos below) and at the
# prebuilt protoc that proto toolchain resolution selects (//bazel/grpc:protoc),
# so Java codegen compiles no C++. `version` must track the bazel_dep above.
single_version_override(
    module_name = "grpc-java",
    patch_strip = 1,
    patches = [
        "//bazel/grpc:prebuilt_plugin.patch",
        "//bazel/grpc:prebuilt_protoc.patch",
    ],
    version = "1.84.0",
)

# Formatting and linting.
bazel_dep(name = "aspect_rules_lint", version = "2.9.1")
bazel_dep(name = "buildifier_prebuilt", version = "10.1.0")
bazel_dep(name = "rules_buf", version = "0.5.4")

# --- Clojure client (//client/clojure, ADR 2) -------------------------------------
# rules_clj builds and tests it; protoc-gen-clojure generates the API namespace
# from the proto in the build (its toolchain fetches a prebuilt native plugin).
bazel_dep(name = "rules_clj", version = "0.2.5")
bazel_dep(name = "protoc_gen_clojure", version = "0.7.0")

protoc_gen_clojure = use_extension("@protoc_gen_clojure//clojure:extensions.bzl", "toolchains")
use_repo(protoc_gen_clojure, "protoc_gen_clojure_toolchains")

register_toolchains("@protoc_gen_clojure_toolchains//:all")

# The Clojure libraries, from //client/clojure:deps.edn through its committed
# lockfile. The lock holds ONLY Clojure source jars (clj-grpc, clj-protobuf):
# gRPC, Netty, protobuf-java and Clojure itself are excluded there and come from
# this module's own pinned targets (@grpc-java, @maven, @protobuf, the rules_clj
# toolchain), so a class path never holds two copies. //client/clojure:classpath_test
# enforces that. Regenerate with `bazel run //client/clojure:lock`.
clj_deps = use_extension("@rules_clj//clojure:extensions.bzl", "deps")
clj_deps.install(
    name = "clj_deps",
    lock = "//client/clojure:deps.lock.json",
)

# The lock tool's own dependencies (tools.deps), from the lockfile rules_clj ships
# for them. rules_clj declares this repository as a dev dependency, so it does not
# exist for a consumer and `bazel run @rules_clj//tools/lock` cannot be analysed
# from here; //client/clojure:lock builds the same program on this copy.
clj_deps.install(
    name = "clj_lock_deps",
    lock = "@rules_clj//tools/lock:deps.lock.json",
)
use_repo(clj_deps, "clj_deps", "clj_lock_deps")

# --- Python (client/python, ADR 3) ------------------------------------------------
# The interpreter is downloaded by rules_python (never the host's), and every
# PyPI package is pinned with hashes in //client/python:requirements_lock.txt.
# Re-lock after editing requirements.in: see the README.
bazel_dep(name = "rules_python", version = "2.4.2")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.13",
)

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "odradek_pypi",
    python_version = "3.13",
    requirements_lock = "//client/python:requirements_lock.txt",
)
use_repo(pip, "odradek_pypi")

# Java proto codegen skips buf/validate/validate.proto; protovalidate-java supplies it.
register_toolchains("//bazel/java:proto_toolchain_toolchain")

# --- Maven ---------------------------------------------------------------------
# One `@maven` repository for the whole workspace. The grpc-java module installs
# into the same-named repository and maps io.grpc:* and protobuf-java onto
# targets it builds from source (maven.override in its MODULE.bazel), so gRPC and
# protobuf are NOT listed here; use @grpc-java//... and @protobuf//java/... .
# The resolved tree, with checksums, is pinned in //:maven_install.json.
# Re-pin after editing this list: `bazel run @maven//:pin`.
maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
maven.install(
    artifacts = [
        # Kafka client (4.x line; Java 17+).
        "org.apache.kafka:kafka-clients:4.3.1",
        # Netty is pinned to 4.2.16.Final, the version grpc-java 1.84.0 is built
        # against (IO_GRPC_GRPC_JAVA_ARTIFACTS in its MODULE.bazel). grpc-netty-shaded
        # is deliberately NOT used. Unix domain sockets for grpc-netty need netty's epoll transport, and its
        # native library is a per-arch classifier jar. Both architectures are
        # listed because the server runs in pods on amd64 and arm64 nodes; the
        # build picks one with a select() on the target CPU (//server).
        "io.netty:netty-transport-native-epoll:jar:linux-x86_64:4.2.16.Final",
        "io.netty:netty-transport-native-epoll:jar:linux-aarch_64:4.2.16.Final",
        "io.netty:netty-transport-native-unix-common:4.2.16.Final",
        # Named directly by the server: the event loop and the domain socket channel.
        "io.netty:netty-transport:4.2.16.Final",
        "io.netty:netty-transport-classes-epoll:4.2.16.Final",
        # And the TLS context of the delivery port (ADR 6), which grpc-netty takes
        # as Netty's own type. Both were already in the tree through grpc-netty.
        "io.netty:netty-buffer:4.2.16.Final",
        "io.netty:netty-handler:4.2.16.Final",
        # protovalidate (Java runtime) evaluates the buf.validate rules of the config
        # protos. Its jar bundles the generated build.buf.validate classes; see
        # //bazel/java:proto_toolchain for how they are kept off the classpath twice.
        # protobuf-java-util resolves to the source-built @protobuf//java/util via
        # grpc-java's maven.override, so there is still a single protobuf runtime.
        "build.buf:protovalidate:1.3.0",
        "com.google.protobuf:protobuf-java-util:4.36.2",
        "org.snakeyaml:snakeyaml-engine:3.2",
        # Logging: the slf4j API in code, logback behind it in the server binary.
        "org.slf4j:slf4j-api:2.0.20",
        "ch.qos.logback:logback-classic:1.5.38",
        # Metrics: the OpenTelemetry SDK, exported over OTLP/gRPC. The exporter's
        # default transport (OkHttp, excluded below) is replaced by the sender that
        # runs on grpc-java, so the server keeps one gRPC and one Netty.
        "io.opentelemetry:opentelemetry-api:1.67.0",
        "io.opentelemetry:opentelemetry-sdk-common:1.67.0",
        "io.opentelemetry:opentelemetry-sdk-metrics:1.67.0",
        "io.opentelemetry:opentelemetry-exporter-otlp:1.67.0",
        "io.opentelemetry:opentelemetry-exporter-sender-grpc-managed-channel:1.67.0",
        "io.opentelemetry:opentelemetry-sdk-testing:1.67.0",
        # Tests: JUnit 6 (Jupiter) via the JUnit Platform console launcher, AssertJ.
        "org.junit.jupiter:junit-jupiter-api:6.1.3",
        "org.junit.jupiter:junit-jupiter-engine:6.1.3",
        "org.junit.platform:junit-platform-console:6.1.3",
        "org.assertj:assertj-core:3.27.7",
    ],
    excluded_artifacts = [
        "io.opentelemetry:opentelemetry-exporter-sender-okhttp",
    ],
    fail_if_repin_required = True,
    known_contributing_modules = [
        "grpc-java",
        "protobuf",
    ],
    lock_file = "//:maven_install.json",
    repositories = ["https://repo.maven.apache.org/maven2/"],
    strict_visibility = True,
)
use_repo(maven, "maven")

# --- Formatter and linter tools --------------------------------------------------
# google-java-format: aspect_rules_lint bundles only 1.17.0, which predates
# current Java syntax, so the jar is pinned here instead (//bazel/format wraps it
# in a java_binary). Bump = new version + new sha256.
http_jar = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_jar")

http_jar(
    name = "google_java_format",
    sha256 = "834b2a0c38cb774953322a84b5ca3f2f40dd3156650b3cd44d3b744345962f7a",
    url = "https://github.com/google/google-java-format/releases/download/v1.37.0/google-java-format-1.37.0-all-deps.jar",
)

# PMD: Java lint (rules_lint aspect, //bazel/lint). aspect_rules_lint bundles only
# 7.7.0, which cannot parse Java 25, so the distribution is pinned here instead.
# Bump = new version in the URL and prefix + new sha256.
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "net_sourceforge_pmd",
    build_file_content = """\
load("@rules_java//java:defs.bzl", "java_import")

java_import(
    name = "net_sourceforge_pmd",
    jars = glob(["*.jar"]),
    visibility = ["//visibility:public"],
)
""",
    sha256 = "f974ba571f7bc01c73fffe11bade25fbc1f438698f9e9c00e416e8d65e9fbac2",
    strip_prefix = "pmd-bin-7.28.0/lib",
    url = "https://github.com/pmd/pmd/releases/download/pmd_releases/7.28.0/pmd-dist-7.28.0-bin.zip",
)

# buf: proto lint (rules_lint aspect, `bazel run //:format` for formatting) and
# breaking-change detection. Pinned here so every machine runs the same binary.
buf = use_extension("@rules_buf//buf:extensions.bzl", "buf")
buf.toolchains(version = "v1.73.0")
use_repo(buf, "rules_buf_toolchains")

# Prebuilt protoc-gen-grpc-java, same version as grpc-java above (see //bazel/grpc).
# osx-x86_64 and osx-aarch_64 are the same universal binary (identical sha256).
http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

http_file(
    name = "protoc_gen_grpc_java_linux_x86_64",
    executable = True,
    sha256 = "907c2d4efc2bae9b21cada75c31b36f3821e15b7be96311e214a6be65bcd20aa",
    url = "https://repo1.maven.org/maven2/io/grpc/protoc-gen-grpc-java/1.84.0/protoc-gen-grpc-java-1.84.0-linux-x86_64.exe",
)

http_file(
    name = "protoc_gen_grpc_java_linux_aarch_64",
    executable = True,
    sha256 = "d9357761b4e69ddc7abec3d3a80e1096b5eda3e25d6ed6d0b1ead07066600a86",
    url = "https://repo1.maven.org/maven2/io/grpc/protoc-gen-grpc-java/1.84.0/protoc-gen-grpc-java-1.84.0-linux-aarch_64.exe",
)

http_file(
    name = "protoc_gen_grpc_java_osx",
    executable = True,
    sha256 = "49aab9e56a30a8484e9c32d36be12a351d5783e00bdaafe9ec2c2fd8c9029504",
    url = "https://repo1.maven.org/maven2/io/grpc/protoc-gen-grpc-java/1.84.0/protoc-gen-grpc-java-1.84.0-osx-aarch_64.exe",
)

# The image base: distroless Java 25 runtime on Debian 13, nonroot variant
# (user 65532). Pinned by INDEX digest -- a tag would let the contents of a
# release change without the build changing. Layers are fetched lazily, only
# when an image is pushed or loaded.
pull = use_repo_rule("@rules_img//img:pull.bzl", "pull")

pull(
    name = "distroless_java25",
    digest = "sha256:28a3986989d7d74cb5cfd6ba369e64d3d634f83ac9fa562dac8db2d20827f90e",
    layer_handling = "lazy",
    registry = "gcr.io",
    repository = "distroless/java25-debian13",
)

# --- GraalVM native image (//server:server_native) ---------------------------------
# rules_graalvm's native_image rule and its GraalVM toolchain: Community Edition
# for JDK 25, downloaded for the machine that builds. native-image cannot
# cross-compile, so each architecture builds on a machine of that architecture.
# 0.12.0 is not in the Bazel Central Registry (its newest there is 0.11.1, which
# does not load on Bazel 9), hence the override on the release archive.
bazel_dep(name = "rules_graalvm", version = "0.12.0")
archive_override(
    module_name = "rules_graalvm",
    integrity = "sha256-2IktQqVOV09uZKsQztwY3rvJpeRjxWE4Stf1FxH/gCI=",
    strip_prefix = "rules_graalvm-0.12.0",
    urls = ["https://github.com/sgammon/rules_graalvm/releases/download/v0.12.0/rules_graalvm-0.12.0.tar.gz"],
)

graalvm = use_extension("@rules_graalvm//:extensions.bzl", "graalvm")
graalvm.graalvm(
    name = "graalvm",
    distribution = "ce",
    java_version = "25",
    version = "25.0.2",
)
use_repo(graalvm, "graalvm")

# Only the native-image toolchain: Java is still compiled and run by remotejdk.
register_toolchains("@graalvm//:toolchain_gvm")

# The base of the native image: glibc and nothing else (no libjvm, no shell, no
# libssl), nonroot variant (user 65532). The executable links zlib in and libc
# dynamically (--static-nolibc), so this is all it needs. Pinned by index digest
# like the Java base above.
pull(
    name = "distroless_base_nossl",
    digest = "sha256:8c563c1fb5e120606f0d85733049775faed6192e2bd2223ef283a5393eec22b9",
    layer_handling = "lazy",
    registry = "gcr.io",
    repository = "distroless/base-nossl-debian13",
)
