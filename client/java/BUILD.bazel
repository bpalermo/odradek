load("@rules_java//java:defs.bzl", "java_library")
load("//bazel:version.bzl", "VERSION")
load("//bazel/java:defs.bzl", "JAVACOPTS")
load("//bazel/maven:defs.bzl", "GRPC_DEPENDENCIES", "maven_artifact")

package(default_visibility = ["//visibility:private"])

# The Java client: the shared protocol core (//client/core) bound to grpc-java.
java_library(
    name = "client",
    srcs = glob(["src/main/java/**/*.java"]),
    javacopts = JAVACOPTS,
    resource_strip_prefix = package_name(),
    resources = [":version"],
    visibility = ["//visibility:public"],
    exports = ["//api/odradek/kafka/v1:odradek_java_proto"],
    deps = [
        "//api/odradek/client/v1:core_java_proto",
        "//api/odradek/kafka/v1:odradek_java_grpc",
        "//api/odradek/kafka/v1:odradek_java_proto",
        "//client/core",
        "@grpc-java//api",
        "@grpc-java//netty",
        "@grpc-java//stub",
        "@maven//:io_netty_netty_transport",
        "@maven//:io_netty_netty_transport_classes_epoll",
        "@maven//:io_netty_netty_transport_native_unix_common",
        "@maven//:org_slf4j_slf4j_api",
        "@protobuf//java/core",
    ],
)

# What the client tells the server about itself, read by Version.java.
genrule(
    name = "version",
    outs = ["odradek-client.version"],
    cmd = "echo -n '%s' > $@" % VERSION,
)

# The Maven artifact: this library with the protocol core and the generated API
# classes inside it; gRPC, Netty, protobuf and slf4j are dependencies.
maven_artifact(
    name = "maven",
    artifact = "odradek-client",
    extra_dependencies = GRPC_DEPENDENCIES,
    visibility = ["//visibility:public"],
    exports = [":client"],
)
